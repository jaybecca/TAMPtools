NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:4000
SESSION_DAYS=7

# Database: SQLite is for local development. Production target: Neon PostgreSQL.
DB_PROVIDER=sqlite
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tamptools
DB_SSL=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# SQLite database is created automatically at backend/data/tamptools.db.

# Payments — automatic routing between Paddle and Flutterwave only.
# Customers never choose a gateway manually. TAMPtools routes by country/currency/language.
PADDLE_API_KEY=REPLACE_ME
PADDLE_WEBHOOK_SECRET=REPLACE_ME
PADDLE_CUSTOMER_PORTAL_URL=
FLW_SECRET_KEY=REPLACE_ME
FLW_WEBHOOK_SECRET=REPLACE_ME
# Price/payment-plan IDs. Configure monthly/yearly IDs per plan/currency.
# PADDLE_PRICE_PRO_USD_MONTHLY=pri_...
# PADDLE_PRICE_PRO_USD_YEARLY=pri_...
# FLW_PRICE_PRO_NGN_MONTHLY=12345
# FLW_PRICE_PRO_NGN_YEARLY=12346

# AI providers (configure only the providers you will actually use)
OPENAI_API_KEY=REPLACE_ME
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=REPLACE_ME
GEMINI_TEXT_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=REPLACE_ME
CLAUDE_TEXT_MODEL=claude-3-5-haiku-latest

# Background removal runs self-hosted (@imgly/background-removal-node) — no API key needed.
# First run downloads its model file once; needs internet access for that initial download only.

# Customer support
SUPPORT_EMAIL=tools@tampconsulting.space
# Enter the full international WhatsApp number without + or spaces.
WHATSAPP_SUPPORT_NUMBER="2349152345734"

# Phase 3.9 locale detection
# Optional: IP geolocation uses edge country headers first, then ipapi.co as a short-time fallback.
IP_GEO_ENABLED=true

# Optional live payment provider settings (required before real charges)
PAYMENT_PROVIDER_SECRET=REPLACE_ME
PAYMENT_PROVIDER_NAME=REPLACE_ME

# Email sending (Resend REST adapter).
RESEND_API_KEY=REPLACE_ME
EMAIL_FROM=TAMPtools <tools@tampconsulting.space>

# Admin
ADMIN_EMAIL=

# Google Sign-In / account linking (implement in the Google OAuth integration step).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback


# File storage
STORAGE_PROVIDER=local
TAMPTOOLS_STORAGE_DIR=
FILE_RETENTION_DAYS=7
# Production recommendation: S3-compatible object storage such as Cloudflare R2.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis / durable queue (required for production worker scaling; not wired into runtime yet).
REDIS_URL=
REDIS_QUEUE_NAME=tamptools
JOB_CONCURRENCY=5
JOB_LOCK_DURATION_MS=60000
FILE_CLEANUP_INTERVAL_MS=3600000


# Required in production to encrypt OAuth access/refresh tokens at rest.
# Use a long random secret (32+ bytes). Never commit the real value.
TAMPTOOLS_ENCRYPTION_KEY=REPLACE_ME


# Phase 4.4 operational hardening

# Optional: set a trusted proxy count when deployed behind a reverse proxy
TRUST_PROXY=0

# Backups / disaster recovery
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=
AWS_REGION=

# Abuse / compliance controls
ACCOUNT_DELETE_GRACE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PROMO_DEFAULT_MAX_REDEMPTIONS=1000

# Production database (Phase 17A / Neon)
# Keep local development on SQLite unless you have a PostgreSQL database configured.
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tamptools
# DB_SSL=true
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=5000

# Cloudflare R2 object storage (Phase 17C)
# Set STORAGE_PROVIDER=r2 in production. Keep local for development if desired.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Mail Manager provider OAuth
# Google Sign-In credentials can be reused for Gmail OAuth, but Gmail requires additional OAuth consent/scopes.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra app credentials for Outlook / Microsoft 365 mailbox access.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Translation is TAMPtools-owned. No external translation API is required.
# Optional: use the configured AI provider to translate strings missing from the curated catalog.
TRANSLATION_AI_ENABLED=0

# Optional IMAP integration. Leave blank to disable IMAP; the app will still run.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_ACCOUNT_EMAIL=
IMAP_FOLDER=INBOX
